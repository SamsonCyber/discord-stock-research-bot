# Required when running the Discord bot. Never commit real values.
STOCK_RESEARCH_DISCORD_TOKEN=

# Comma-separated Discord user IDs. Empty means the bot refuses to start.
STOCK_RESEARCH_ALLOWED_USER_IDS=

# Optional: path to a local file of user IDs (one per line or comma-separated).
# STOCK_RESEARCH_ALLOWED_USER_IDS_FILE=

# Optional: register slash commands to one test guild for faster development.
STOCK_RESEARCH_TEST_GUILD_ID=
